<%- include("header.ejs") %>

<h1>Reading Page</h1>

<% if (data.length === 0) { %>
    <p>No posts found.</p>
<% } else { %>
    <% data.forEach((post) => { %>
        <article>
            <a href="/posts/<%= post.slug %>"><%= post.title %></a>
            <p><%= post.body %></p>
        </article>
    <% }) %>
<% } %>

<%- include("footer.ejs") %>