<%- include("header.ejs") %>

<main>
    <div class="writing-page">
        <div class="writing-body-container main-block">
            <% if (data.length === 0) { %>
                <p>No posts found.</p>
            <% } else { %>
                <% data.forEach(post => { %>
                    <a href="/posts/<%= post.slug %>"><%= post.title %></a>
                <% }); %>
            <% } %>
        </div>
    </div>
</main>

<%- include("footer.ejs") %>